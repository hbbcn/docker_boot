# 这是可以执行成功的dockerfile
FROM centos:7
LABEL maintainer="hbbcn <huangqbcn@gmai.com>"

ENV MYPATH /usr/local
WORKDIR $MYPATH

# 1. 修复 yum 源为阿里云镜像（公网版）
# 改动点：删除了替换为内网地址的 sed 命令，保留公网地址 mirrors.aliyun.com
RUN curl -o /etc/yum.repos.d/CentOS-Base.repo https://mirrors.aliyun.com/repo/Centos-7.repo \
    && yum clean all

# 安装vim编辑器
RUN yum --disableplugin=fastestmirror -y install vim

# 安装ifconfig命令查看网络IP
RUN yum --disableplugin=fastestmirror -y install net-tools

# 安装java8及lib库
RUN yum --disableplugin=fastestmirror -y install glibc.i686

# 创建Java目录
RUN mkdir -p /usr/local/java

# ADD 是相对路径jar,把jdk-8u261-linux-x64.tar.gz添加到容器中
# 安装包必须要和Dockerfile文件在同一位置
ADD jdk-8u261-linux-x64.tar.gz /usr/local/java/

# 配置java环境变量（注意：解压后的文件夹名可能是 jdk1.8.0_261）
ENV JAVA_HOME /usr/local/java/jdk1.8.0_261
ENV JRE_HOME $JAVA_HOME/jre
ENV CLASSPATH $JAVA_HOME/lib/dt.jar:$JAVA_HOME/lib/tools.jar:$JRE_HOME/lib:$CLASSPATH
ENV PATH $JAVA_HOME/bin:$PATH

EXPOSE 80

CMD echo $MYPATH && echo "success--------------ok" && /bin/bash